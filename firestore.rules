rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.email == 'wpsabbir688@gmail.com' ||
          request.auth.token.email == 'wpsabbir44@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // Destination Entity Validation
    function isValidDestination(data) {
      return data.titleBn is string && data.titleBn.size() > 0 && data.titleBn.size() <= 150 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100 &&
             data.summaryBn is string && data.summaryBn.size() > 0 && data.summaryBn.size() <= 500 &&
             data.upazilaId is string && data.upazilaId.size() <= 50 &&
             data.status in ['draft', 'published'] &&
             (!('descriptionBn' in data) || (data.descriptionBn is string && data.descriptionBn.size() <= 15000)) &&
             (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() <= 150)) &&
             (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 1500)) &&
             (!('coverImageAlt' in data) || (data.coverImageAlt is string && data.coverImageAlt.size() <= 300)) &&
             (!('locationName' in data) || (data.locationName is string && data.locationName.size() <= 300)) &&
             (!('googleMapsUrl' in data) || (data.googleMapsUrl is string && data.googleMapsUrl.size() <= 1500)) &&
             (!('howToGetThereBn' in data) || (data.howToGetThereBn is string && data.howToGetThereBn.size() <= 4000)) &&
             (!('bestSeasonBn' in data) || (data.bestSeasonBn is string && data.bestSeasonBn.size() <= 300)) &&
             (!('openingHours' in data) || (data.openingHours is string && data.openingHours.size() <= 300)) &&
             (!('entryFee' in data) || (data.entryFee is string && data.entryFee.size() <= 300)) &&
             (!('travelTipsBn' in data) || (data.travelTipsBn is string && data.travelTipsBn.size() <= 4000)) &&
             (!('accessibilityNotesBn' in data) || (data.accessibilityNotesBn is string && data.accessibilityNotesBn.size() <= 1500)) &&
             (!('safetyNotesBn' in data) || (data.safetyNotesBn is string && data.safetyNotesBn.size() <= 1500)) &&
             (!('lastVerifiedAt' in data) || (data.lastVerifiedAt is string && data.lastVerifiedAt.size() <= 100)) &&
             (!('isFeatured' in data) || data.isFeatured is bool) &&
             (!('categoryIds' in data) || (data.categoryIds is list && data.categoryIds.size() <= 20));
    }

    // Category Entity Validation
    function isValidCategory(data) {
      return data.nameBn is string && data.nameBn.size() > 0 && data.nameBn.size() <= 100 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 50 &&
             (!('descriptionBn' in data) || (data.descriptionBn is string && data.descriptionBn.size() <= 500)) &&
             (!('nameEn' in data) || (data.nameEn is string && data.nameEn.size() <= 100)) &&
             (!('icon' in data) || (data.icon is string && data.icon.size() <= 50)) &&
             (!('order' in data) || (data.order is int || data.order is float));
    }

    // Contact Entity Validation
    function isValidContact(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 3000 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30));
    }

    // Admin Entity Validation
    function isValidAdmin(data) {
      return data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.role is string && data.role.size() <= 50;
    }

    // Active session presence validation
    function isValidActiveSession(data) {
      return data.lastActive is int || data.lastActive is float;
    }

    // Destinations collection
    match /destinations/{destinationId} {
      allow get, list: if (resource.data.status == 'published') || true;
      allow create: if isValidId(destinationId) && isValidDestination(incoming());
      allow update: if isValidId(destinationId) && isValidDestination(incoming());
      allow delete: if isValidId(destinationId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isValidId(categoryId);
    }

    // Admins collection (sub-admins and roles)
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId);
    }

    // Contacts collection (public write, admin read/delete)
    match /contacts/{contactId} {
      allow create: if isValidId(contactId) && isValidContact(incoming());
      allow read, delete: if isVerifiedAdmin();
      allow update: if false;
    }

    // Real-time live sessions for analytics & presence counter
    match /active_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isValidId(sessionId) && isValidActiveSession(incoming());
      allow delete: if isValidId(sessionId);
    }

    // System settings (admin credentials & site config)
    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // Notifications & Festivals collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isValidId(notificationId);
    }

    // Analytics Events collection (client event logging and admin reading)
    match /analyticsEvents/{eventId} {
      allow create: if isValidId(eventId);
      allow read, delete: if true;
    }

    // Team Members collection
    match /teamMembers/{memberId} {
      allow read, write: if true;
    }

    // Admin Profiles collection
    match /adminProfiles/{profileId} {
      allow read, write: if true;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 150 &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 100 &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 1500)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1500)) &&
             (!('location' in data) || data.location == null || (data.location is string && data.location.size() <= 150)) &&
             (!('savedDestinationIds' in data) || (data.savedDestinationIds is list && data.savedDestinationIds.size() <= 500)) &&
             (!('followersCount' in data) || (data.followersCount is int || data.followersCount is float)) &&
             (!('followingCount' in data) || (data.followingCount is int || data.followingCount is float)) &&
             (!('postsCount' in data) || (data.postsCount is int || data.postsCount is float));
    }

    // Community Post Validation
    function isValidCommunityPost(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.caption is string && data.caption.size() > 0 && data.caption.size() <= 1000 &&
             (!('travelStory' in data) || (data.travelStory is string && data.travelStory.size() <= 15000)) &&
             (!('photos' in data) || (data.photos is list && data.photos.size() <= 10)) &&
             (!('status' in data) || data.status in ['published', 'hidden', 'flagged']);
    }

    // Post Comment Validation
    function isValidPostComment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.postId is string && data.postId.size() <= 128 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2000;
    }

    // Users collection (User Profiles)
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isVerifiedAdmin()) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isVerifiedAdmin()) && isValidUserProfile(incoming());
      allow delete: if isVerifiedAdmin();
    }

    // Community Posts collection
    match /posts/{postId} {
      allow get, list: if true;
      allow create: if isValidId(postId) && isSignedIn() && (incoming().authorId == request.auth.uid || isVerifiedAdmin()) && isValidCommunityPost(incoming());
      allow update: if isValidId(postId) && (
        (isSignedIn() && (resource.data.authorId == request.auth.uid || isVerifiedAdmin())) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'sharesCount'])
      );
      allow delete: if isValidId(postId) && isSignedIn() && (resource.data.authorId == request.auth.uid || isVerifiedAdmin());
    }

    // Post Comments collection
    match /post_comments/{commentId} {
      allow get, list: if true;
      allow create: if isValidId(commentId) && isSignedIn() && incoming().authorId == request.auth.uid && isValidPostComment(incoming());
      allow update, delete: if isValidId(commentId) && isSignedIn() && (resource.data.authorId == request.auth.uid || isVerifiedAdmin());
    }

    // Post Likes collection
    match /post_likes/{likeId} {
      allow get, list: if true;
      allow create: if isValidId(likeId) && isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isValidId(likeId) && isSignedIn() && (resource.data.userId == request.auth.uid || isVerifiedAdmin());
    }

    // Saved Items collection
    match /saved_items/{saveId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isVerifiedAdmin());
      allow create: if isValidId(saveId) && isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isValidId(saveId) && isSignedIn() && (resource.data.userId == request.auth.uid || isVerifiedAdmin());
    }

    // Follows collection
    match /follows/{followId} {
      allow get, list: if true;
      allow create: if isValidId(followId) && isSignedIn() && incoming().followerId == request.auth.uid;
      allow delete: if isValidId(followId) && isSignedIn() && (resource.data.followerId == request.auth.uid || isVerifiedAdmin());
    }

    // Chat Conversations collection
    match /chat_conversations/{conversationId} {
      allow get, list: if true;
      allow create, update: if isValidId(conversationId);
      allow delete: if isVerifiedAdmin();
    }

    // Chat Messages collection
    match /chat_messages/{messageId} {
      allow get, list: if true;
      allow create, update: if isValidId(messageId);
      allow delete: if isVerifiedAdmin();
    }

    // Reports collection
    match /reports/{reportId} {
      allow create: if isValidId(reportId);
      allow get, list, update, delete: if isVerifiedAdmin();
    }

    // Test collection for boot connectivity check
    match /test/{docId} {
      allow read: if true;
    }
  }
}
